# Supply-chain hardening
ignore-scripts=true
# min-release-age=7  ← NOT supported by npm core (RFC never shipped).
#   See PENDING ITEMS — use Socket Security action in CI as the real equivalent.
allow-git=none
save-exact=true

# TRADE-OFFS:
#
# ignore-scripts=true
#   Breaks packages that compile native bindings at install time. This project
#   uses onnxruntime-node, sharp, and prisma — all of which need post-install
#   build steps. After `npm ci` you must manually run:
#     npx prisma generate
#   onnxruntime-node and sharp ship pre-built binaries via postinstall Download
#   scripts; those won't run with ignore-scripts. For local dev, override once:
#     npm install --ignore-scripts=false
#   In CI the build-test job handles prisma generate explicitly.
#
# allow-git=none
#   Prevents git+https:// or github:user/repo URLs in dependencies.
#   Those bypass the registry, skip integrity/provenance checks, and pull
#   arbitrary code. If you ever need a git dep (e.g. a fork before publishing),
#   remove this line temporarily and document the exception in the PR.
#
# save-exact=true
#   New installs pin exact versions (no ^ or ~) so lockfile stays authoritative
#   and accidental upgrades on a fresh install are impossible.
