{
  "name": "botzin",
  "version": "0.1.0",
  "private": true,
  "description": "Local TypeScript architecture for Tibia screen perception through OBS preview and optional Raspberry Pi HID execution.",
  "type": "module",
  "scripts": {
    "build": "npm run frontend:build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "config:dev": "tsx src/web/config-server.ts",
    "dev": "tsx src/index.ts",
    "frontend:dev": "vite frontend",
    "frontend:build": "vite build frontend",
    "frontend:typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "migrate": "tsx src/database/migrate.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "user:create-admin": "tsx src/database/create-admin-user.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.14.0",
    "obs-websocket-js": "^5.0.8",
    "onnxruntime-node": "1.21.1",
    "prisma": "^6.19.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "happy-dom": "20.10.6",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
